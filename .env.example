# Copy this file to .env and fill in your values.
# The app loads this automatically on startup (via python-dotenv).

# Required for the "Ask the Data" tab
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Path to your LiteLLM JSONL log archive (.zip containing *.jsonl files)
# Default if not set: data/logs.zip  (relative to this directory)
DATA_ZIP=path/to/your/logs.zip
